{
  "name": "flying-tapestries-of-arabia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flying Tapestries of Arabia - a 3D open-world flying and spellcasting game for Android phones.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:fast": "FAST=1 vitest run",
    "balance": "tsx scripts/balance-report.ts",
    "balance:solve": "tsx scripts/solve-balance.ts",
    "dev:server": "wrangler dev --port 8787 --ip 127.0.0.1",
    "test:coop": "tsx scripts/test-coop.ts",
    "stress:browser": "node scripts/stress-browser.cjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
